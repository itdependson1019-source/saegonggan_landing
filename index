    <div class="onsite">
      <label><input type="checkbox" id="onsiteChk" ${state.onsite?"checked":""} onchange="state.onsite=this.checked">
      <span>현장 세팅·공간 안내도 원해요 (옵션)<span class="note">※ 일정에 따라 배정돼요 (화·수·목 제외)</span></span></label>
    </div>`:"";
  document.getElementById("dialog").innerHTML=`
    <button class="close" onclick="closeModal()">${I.x}</button>
    <div class="dhead">
      <h2>${s.name}</h2>
      <div class="meta"><span>${I.pin}부천 원종동</span><span>${I.users}${s.cap}</span>${s.area?`<span>${s.area}</span>`:""}</div>
      <div class="dtags">${s.tags.map(t=>`<span>#${t}</span>`).join("")}</div>
    </div>
    <div class="dbody">
      <div class="dlabel">대여 방식</div>
      <div class="toggle">
        <button class="${!isBundle?"on":""}" onclick="setMode('space')">공간만</button>
        <button class="${isBundle?"on":""}" onclick="setMode('bundle')">${I.spark}모객·운영 지원</button>
      </div>
      <ul class="checklist">${list}</ul>
      ${onsiteBlock}

      <div class="dlabel">희망 날짜</div>
      <div class="datewrap">
        <input type="date" id="dateInput" min="${todayStr()}" onchange="onDate(this.value)">
        <div class="datehint" id="dateHint">${s.market?"※ 원종중앙시장 공간은 월요일 휴무예요.":"원하는 날짜를 골라주세요. 확정은 상담에서 함께 맞춰요."}</div>
      </div>

      <div class="dlabel">요금 (1일 기준)</div>
      <div class="pricebox">
        <div class="pricerow"><span>공간 대여료</span><span class="n">${won(s.price)}</span></div>
        ${isBundle?`<div class="pricerow"><span>운영지원비</span><span class="n">+${won(BUNDLE_ADD)}</span></div>`:""}
        <div class="pricerow total"><span>합계</span><span class="n">${won(total)}</span></div>
      </div>

      <button class="btn btn-primary btn-full btn-lg applybtn" id="applyBtn" onclick="apply()">신청하기 (기획서 접수) ${I.arrow}</button>
      <div class="applyhint">신청서를 작성하면 24시간 이내에 담당자가 카톡으로 연락드려요.</div>
    </div>`;
  refreshApplyBtn();
}
function setMode(m){state.mode=m;track("toggle_change",{spaceId:state.spaceId,mode:m});renderDetail(SPACES.find(x=>x.id===state.spaceId));}
function todayStr(){const d=new Date();return d.toISOString().slice(0,10);}
function onDate(v){
  state.date=v;
  const s=SPACES.find(x=>x.id===state.spaceId);
  const hint=document.getElementById("dateHint");
  if(s.market && v && new Date(v).getDay()===1){
    hint.textContent="선택하신 날짜는 월요일이에요. 이 공간은 시장 휴무일이라 다른 날을 추천해요.";
    hint.className="datehint warn";
  }else{
    hint.textContent=s.market?"※ 원종중앙시장 공간은 월요일 휴무예요.":"확정은 상담에서 함께 맞춰요.";
    hint.className="datehint";
  }
  track("date_select",{spaceId:state.spaceId});
  refreshApplyBtn();
}
function refreshApplyBtn(){const b=document.getElementById("applyBtn");if(b)b.disabled=!state.date;}

/* ===== APPLY → prefilled Google Form ===== */
function buildFormUrl(){
  const s=SPACES.find(x=>x.id===state.spaceId);
  const p=new URLSearchParams();
  p.set("usp","pp_url");
  p.set(ENTRY.space,s.name);
  p.set(ENTRY.mode,MODE_LABEL[state.mode]);
  p.set(ENTRY.date,state.date);
  p.set(ENTRY.onsite,state.onsite?"예":"아니오");
  return FORM_BASE+"?"+p.toString();
}
function apply(){
  if(!state.date)return;
  track("apply_submit",{spaceId:state.spaceId,mode:state.mode});
  window.open(buildFormUrl(),"_blank","noopener");
  showSuccess();
}
function showSuccess(){
  document.getElementById("dialog").innerHTML=`
    <button class="close" onclick="closeModal()">${I.x}</button>
    <div class="success">
      <div class="ok">${I.check}</div>
      <h2>신청서를 새 탭에서 열었어요!</h2>
      <p>이름·연락처만 채워 제출하면 접수 완료돼요.<br>24시간 이내에 담당자가 카톡으로 연락드립니다.</p>
      <a class="btn btn-kakao btn-lg" href="${KAKAO}" target="_blank" rel="noopener" onclick="track('kakao_connect_click',{})">${I.chat} 카톡으로 미리 이야기하기</a>
      <div style="margin-top:14px"><a href="${INSTA}" target="_blank" rel="noopener" style="color:var(--green-dark);font-weight:700;text-decoration:none;font-size:14px">인스타 팔로우 @new_2026.p</a></div>
    </div>`;
}

/* ===== PROGRAM CTA (조건부 노출) ===== */
function mountProgramCTA(){
  if(!PROGRAM_FORM_URL)return; // URL 없으면 버튼 미노출
  const box=document.querySelector(".teaser .body");
  if(box){box.insertAdjacentHTML("beforeend",
    `<div style="margin-top:14px"><a class="btn btn-primary" href="${PROGRAM_FORM_URL}" target="_blank" rel="noopener" onclick="track('program_form_click',{})">프로그램 참여 신청 ${I.arrow}</a></div>`);}
}

/* ===== STAT DONUT (scroll animation) ===== */
function animateStat(){
  const arc=document.getElementById("donutArc"), num=document.getElementById("donutNum");
  if(!arc||arc.dataset.done)return; arc.dataset.done="1";
  const C=2*Math.PI*52, pct=64;
  arc.style.strokeDasharray=C; arc.style.strokeDashoffset=C;
  requestAnimationFrame(()=>{arc.style.strokeDashoffset=C*(1-pct/100);});
  let n=0; const t=setInterval(()=>{n+=2;if(n>=pct){n=pct;clearInterval(t);}num.textContent=n;},26);
}
(function(){
  const el=document.querySelector(".stat-viz"); if(!el)return;
  if(!("IntersectionObserver" in window)){animateStat();return;}
  new IntersectionObserver((es,o)=>{es.forEach(e=>{if(e.isIntersecting){animateStat();o.disconnect();}})},{threshold:.4}).observe(el);
})();

/* ===== INIT ===== */
renderCards();
mountProgramCTA();
track("page_view",{});
</script>
</body>
</html>
